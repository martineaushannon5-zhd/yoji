# ===== 运行环境 =====
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# ===== 安全配置（必改）=====
# 生成方式：openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_TTL_DAYS=30
# 后台管理令牌，生成方式同上；留空则 /api/admin 接口关闭
ADMIN_TOKEN=replace-with-another-random-token

# ===== 数据与媒体 =====
DATA_DIR=/opt/yoji/data
MEDIA_DIR=/opt/yoji/media
PUBLIC_MEDIA_PREFIX=/media

# ===== 其他 =====
# Nginx 反向代理时保持 1；直接暴露 Node 时可改为 0
TRUST_PROXY=1
CORS_ORIGIN=*
BCRYPT_ROUNDS=10
MAX_PROGRESS_BYTES=1048576
