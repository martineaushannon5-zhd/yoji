# ===== 运行环境 =====
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# ===== 安全配置（必改）=====
# 生成方式：openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_TTL_DAYS=30
# 后台管理令牌，生成方式同上；留空则 /api/admin 接口关闭
# 管理后台登录密码就是这里的 ADMIN_TOKEN
ADMIN_TOKEN=replace-with-another-random-token
# 管理后台登录账号（默认 admin）
ADMIN_ACCOUNT=admin
# 管理后台 JWT 有效期（默认 12 小时）
ADMIN_JWT_TTL=12h

# ===== 数据与媒体 =====
DATA_DIR=/opt/yoji/data
MEDIA_DIR=/opt/yoji/media
PUBLIC_MEDIA_PREFIX=/media

# ===== 其他 =====
# Nginx 反向代理时保持 1；直接暴露 Node 时可改为 0
TRUST_PROXY=1
CORS_ORIGIN=*
BCRYPT_ROUNDS=10
MAX_PROGRESS_BYTES=1048576

# ===== 视频直传 OSS（可选）=====
# 五项全部填写才会启用；缺任意一项自动回退到 MEDIA_DIR 本地磁盘。
# 建议用 RAM 子账号，只授予该 Bucket 的 oss:PutObject 权限，不要用主账号 AK。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=oss-cn-hangzhou
# 公网访问前缀：CDN 域名（推荐，如 https://cdn.example.com）或 OSS 默认域名
OSS_PUBLIC_BASE=
# Bucket 内目录前缀，迁移脚本的 --to 要和它对应
OSS_DIR=media
# 直传签名有效期（秒，最大 3600）
OSS_SIGN_TTL=600
